<%- include("partials/header.ejs") %>


    <div class="container py-5">    
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <header class="text-center mb-5">
                    
                    <h1 class="display-4 fw-bold"> Welcome to My Blog! </h1>

                    <p class="text-muted"> Share whatever your heart desires.</p>
                
                </header>
                
                <!-- CREATE POST-->
                <section class="card shadow-sm border-0 mb-5">
                    
                    <div class="card-body p-4">

                        <h2 class="h3 mb-3">Create Post </h2>
                        <!-- Post Form-->
                        <form action = "/posts" method="POST">
                            <div class="row g-3 mb-4"> 

                                <div class="col-md-6">

                                    <label
                                        for="title"
                                        class="form-label">
                                    </label>
                                    <input
                                        type="text"
                                        id="title"
                                        name="title"
                                        class="form-control"
                                        placeholder="Post Title" required
                                    >
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label
                                for="content"
                                class="form-label"> 
                                What would you like to say?
                            </label>
                                <textarea
                                    id="postcontent"
                                    name="postContent"
                                    class="form-control"
                                    placeholder="Write your post here..." required
                                ></textarea>
                            </div>

                                <button type="submit" class="btn btn-primary"> Publish Post </button>
                        </form>
                    </div>
                </section>

                <!-- ALL POSTS -->
                <section>
                    
                    <h2 class="mb-4"> Latest Posts </h2>
                    
                    <!-- Post Template / Displays post-->
                    <% posts.forEach(post => { %>

                        <article class="card post-card shawdow-sm border-0 mb-4">
                            <div class="card-body p-4">
                                
                                <h3 class="card-title"> <%= post.title %> </h3>

                                <p class="post-info"> By: <%= post.creator_name %> ♡ <%= new Date(post.date_created).toLocaleDateString() %> </p>

                                <p class="card-text"> <%= post.body %></p>

                                <div class="d-flex gap-3 mt-4">
                                
                                <!-- Hides edit and delete buttons for guests not logged in -->
                                <% if (user && user === post.creator_user_id) { %>
                                <!--Edit Post-->

                                    <a href="/posts/<%= post.blog_id %>/edit" class="btn btn-outline-primary btn-sm"> Edit </a>

                                    <!--Delete Post-->
                                    
                                    <form 

                                        action="/posts/<%= post.blog_id %>/delete" method="POST"> 
                                        <button type="submit" class="btn btn-outline-danger btn-sm"> Delete </button>
                                    
                                    </form>
                                <% } %>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </section>
            </div>
        </div>
    </div>

<%- include("partials/footer.ejs") %>
